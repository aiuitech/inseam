/// The loaded-plugin contract (`design/plugins.md`): the service seams
/// projected across the component boundary — the native seam is the source
/// of truth; each WIT world here is its projection, kept in lockstep with
/// `inseam-seams`. This file holds what every seam shares (the `host` and
/// `fetch` capability imports) and the `transforms` seam; `connection.wit`
/// holds the `connections` seam.
///
/// Capabilities are imports: a component only ever receives what the bridge
/// hands it, attenuated per its manifest. There are no sockets, no
/// filesystem, no clocks — a plugin describes work; the host performs it.
package inseam:plugin@0.1.0;

/// Host capabilities, granted per the plugin's manifest. Calling a function
/// the manifest did not request (or whose budget is spent) returns an error
/// string; a well-behaved plugin degrades to doing less.
interface host {
    /// Diagnostic logging into the node's tracing output.
    log: func(message: string);

    /// One metered LLM completion (requires the `llm` capability). Model
    /// choice and budgeting belong to the host, not the plugin.
    llm-complete: func(system: string, user: string) -> result<string, string>;

    /// One metered vision call: OCR, captioning (requires `llm`).
    llm-describe-image: func(prompt: string, mimetype: string, image: list<u8>) -> result<string, string>;

    /// The raw bytes of the claimed fragment (requires the `source-bytes`
    /// capability): the source's own bytes at the root, or the content a
    /// non-root fragment references (an image a document links to) when
    /// the plugin claims non-roots too.
    source-bytes: func() -> result<list<u8>, string>;
}

interface transform {
    /// The envelope of the source under transformation.
    record envelope {
        source-type: string,
        content-type: string,
        hint: option<string>,
        /// Unix-epoch seconds.
        modified: option<s64>,
        raw-bytes: u64,
    }

    /// What this transform claims. The bridge intersects these with the
    /// manifest's declared claims — the effective claim set is
    /// `declared AND exported`, so a component cannot quietly widen its
    /// reach past what its manifest promised.
    record claim-spec {
        /// Mimetype essences (`image/png`) or `type/*` patterns.
        mimetypes: list<string>,
        /// Claim source roots only, or emitted fragments too.
        roots-only: bool,
    }

    /// One emitted fragment. WIT has no recursive types, so the sprout tree
    /// is flattened: `parent` indexes an EARLIER fragment in the same list,
    /// and `none` hangs the fragment off the claimed fragment itself.
    record fragment {
        parent: option<u32>,
        /// Mimetype of the emitted fragment, params allowed
        /// (`text/plain;via=ocr`).
        mimetype: string,
        /// Kind of the edge from the parent to this fragment, read
        /// parent -> child: the kernel's `contains` (structural child) or
        /// `derives` (derived understanding), or a kind this plugin defines
        /// (kebab-case, e.g. `transcribes`). Malformed names fall back to
        /// `contains`.
        relation: string,
        text: option<string>,
    }

    record output {
        fragments: list<fragment>,
    }

    claims: func() -> claim-spec;

    /// Transform one claimed fragment. Infallible by contract on the seam:
    /// an error here is logged and treated as an empty output — indexing is
    /// enrichment, and a broken transform must not gate the source.
    apply: func(env: envelope, mimetype: string, is-root: bool, text: option<string>) -> result<output, string>;
}

/// The node's guarded HTTP request, performed on the component's behalf
/// (requires `[capabilities] hosts = [...]` — the manifest names every host
/// the plugin may contact, and the guard refuses everything else, redirect
/// hops included). The node owns the network stack: it resolves the host,
/// pins the connection, caps the body, and times the request out; the
/// component only describes the request.
interface fetch {
    /// One request to perform. `method` is one of GET, HEAD, POST, PUT,
    /// PATCH, DELETE. Headers the transport owns (`host`,
    /// `content-length`, ...) are refused. With `authorize`, the node
    /// attaches the bearer token of the OAuth grant the entry names
    /// (requires `[capabilities] grant = true`); the token itself never
    /// crosses this boundary.
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        authorize: bool,
    }

    /// The answer, status included: a non-success status is an answer a
    /// plugin reads for itself, never an error. The body is under the
    /// entry's byte cap.
    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// Perform one request. Errors are the guard's refusals (a host the
    /// manifest does not name, a private address, a spent call budget),
    /// the network's, and the caps'.
    fetch: func(request: request) -> result<response, string>;
}

world transform-plugin {
    import host;
    import fetch;
    export transform;
}
