{
  "name": "@inseam/brand",
  "version": "0.1.0",
  "description": "The inseam brand for Tailwind v4 and shadcn apps: theme, assets, and the components tuned to them.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./assets/*": "./assets/*",
    "./components/*": "./components/*.tsx",
    "./lib/*": "./lib/*.ts"
  },
  "files": [
    "assets",
    "components",
    "lib",
    "theme.css",
    "components.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/react": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "~6"
  }
}
